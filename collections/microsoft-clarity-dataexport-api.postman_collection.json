          "request": {
            "name": "Fetch project live insights",
            "description": {
              "content": "Fetches dashboard data for a Clarity project over the last 1, 2,\nor 3 days, broken down by up to three dimensions. Returns\nmetrics including Traffic, Engagement Time, Scroll Depth,\nPopular Pages, Browser, Device, OS, Country/Region, Page Title,\nReferrer URL, Dead Click Count, Excessive Scroll, Rage Click\nCount, Quickback Click, Script Error Count, and Error Click\nCount.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "export-data",
                "api",
                "v1",
                "project-live-insights"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "numOfDays",
                  "value": "<integer>",
                  "description": "(Required) Number of days for export (1, 2, or 3)"
                },
                {
                  "disabled": false,
                  "key": "dimension1",
                  "value": "<string>"
                },
                {
                  "disabled": false,
                  "key": "dimension2",
